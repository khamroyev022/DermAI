# ---- Django ---------------------------------------------------------------
DJANGO_SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=*

# ---- MySQL (the ONLY relational database) ---------------------------------
MYSQL_DATABASE=bookai
MYSQL_USER=bookai
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Inside docker-compose the host is the service name "mysql".
# For running the backend on your machine against the compose MySQL use
# MYSQL_HOST=127.0.0.1 and MYSQL_PORT=3307 (see MYSQL_HOST_PORT).
MYSQL_HOST=mysql
MYSQL_PORT=3306
# Host port the compose MySQL is published on (3307 avoids clashing with a local MySQL).
MYSQL_HOST_PORT=3307

# ---- Redis / Celery --------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ---- Qdrant (vectors only) -------------------------------------------------
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=document_chunks

# ---- Gemini (backend only — never exposed to the frontend) -----------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- Embeddings / RAG ------------------------------------------------------
EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_BATCH_SIZE=32

RAG_TOP_K=6
RAG_SIMILARITY_THRESHOLD=0.78

# CHUNK_SIZE / CHUNK_OVERLAP are measured in characters (~200 / ~40 tokens).
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# Number of previous messages sent to the LLM for follow-up questions.
CHAT_HISTORY_MESSAGES=8

MAX_PDF_SIZE_MB=100

# ---- Ports -----------------------------------------------------------------
# Host ports the backend / nginx frontend containers are published on.
BACKEND_PORT=8000
FRONTEND_PORT=5173

# ---- Frontend --------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
